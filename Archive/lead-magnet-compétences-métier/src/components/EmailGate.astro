---
---
<section id="email-gate" class="min-h-screen flex items-center justify-center relative overflow-hidden px-4">
  <!-- Decorative gradient circle -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute top-20 right-20 w-[300px] h-[300px] bg-accent-gold/5 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <p class="text-purple-light text-sm font-semibold tracking-widest uppercase mb-6">Audit gratuit — 5 minutes</p>

    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
      Tes compétences métier valent <span class="text-purple-light">130&nbsp;000&nbsp;€.</span>
    </h1>

    <p class="text-lg md:text-xl text-warm-gray mb-10 max-w-lg mx-auto">
      Chaque expert qui quitte ta boîte emporte un savoir que tu n'as jamais écrit nulle part. Découvre combien tu risques.
    </p>

    <!-- Stats cards -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
      <div class="bg-navy-light/60 border border-white/10 rounded-xl px-6 py-4 backdrop-blur-sm">
        <div class="text-3xl font-bold text-purple-light">130k€</div>
        <div class="text-sm text-warm-gray mt-1">Coût moyen de remplacement d'un expert</div>
      </div>
      <div class="bg-navy-light/60 border border-white/10 rounded-xl px-6 py-4 backdrop-blur-sm">
        <div class="text-3xl font-bold text-purple-light">67%</div>
        <div class="text-sm text-warm-gray mt-1">Des PME n'ont aucune procédure documentée</div>
      </div>
    </div>

    <!-- Form — chips UI -->
    <form id="email-form" class="flex flex-col gap-6 max-w-md mx-auto mb-4">
      <!-- Prénom -->
      <div>
        <label class="text-xs text-warm-gray/60 uppercase tracking-wider mb-2 block text-left">Prénom</label>
        <input
          type="text"
          id="name-input"
          placeholder="François"
          required
          maxlength="50"
          pattern="[A-Za-zÀ-ÿ\s\-']+"
          class="gate-field w-full px-5 py-3.5 rounded-xl bg-navy-light/80 border border-white/20 text-white placeholder-warm-gray/50 input-focus text-base"
        />
      </div>

      <!-- Email -->
      <div>
        <label class="text-xs text-warm-gray/60 uppercase tracking-wider mb-2 block text-left">Email pro</label>
        <input
          type="email"
          id="email-input"
          placeholder="francois@cabinet.com"
          required
          maxlength="254"
          class="gate-field w-full px-5 py-3.5 rounded-xl bg-navy-light/80 border border-white/20 text-white placeholder-warm-gray/50 input-focus text-base"
        />
      </div>

      <!-- Secteur (choix unique) -->
      <div>
        <label class="text-xs text-warm-gray/60 uppercase tracking-wider mb-3 block text-left">Ton secteur</label>
        <input type="hidden" id="sector-input" />
        <div class="flex flex-wrap gap-2.5 justify-center" id="sector-chips" role="radiogroup" aria-label="Ton secteur">
          <button type="button" data-value="Finance / Comptabilité / Fiduciaire" role="radio" aria-checked="false" class="chip px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40">Finance &amp; Compta</button>
          <button type="button" data-value="Conseil / Services aux entreprises" role="radio" aria-checked="false" class="chip px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40">Conseil</button>
          <button type="button" data-value="Agence (marketing, dev, créa)" role="radio" aria-checked="false" class="chip px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40">Agence</button>
          <button type="button" data-value="E-commerce / Retail" role="radio" aria-checked="false" class="chip px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40">E-commerce</button>
          <button type="button" data-value="Immobilier / Gestion de patrimoine" role="radio" aria-checked="false" class="chip px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40">Immobilier</button>
          <button type="button" data-value="Autre" role="radio" aria-checked="false" class="chip px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40">Autre</button>
        </div>
      </div>

      <!-- Pain point (choix multiple) -->
      <div>
        <label class="text-xs text-warm-gray/60 uppercase tracking-wider mb-1 block text-left">Tes plus grosses pertes de temps</label>
        <span class="text-xs text-purple-light/60 block mb-3 text-left">Plusieurs choix possibles</span>
        <div class="flex flex-wrap gap-2.5 justify-center" id="pain-chips" role="group" aria-label="Tes plus grosses pertes de temps">
          <button type="button" data-value="Relances clients / suivi des paiements" role="checkbox" aria-checked="false" class="chip chip-multi px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40 inline-flex items-center">
            <svg class="chip-check w-3.5 h-3.5 mr-1.5 hidden shrink-0" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Relances &amp; paiements
          </button>
          <button type="button" data-value="Reporting et documents récurrents" role="checkbox" aria-checked="false" class="chip chip-multi px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40 inline-flex items-center">
            <svg class="chip-check w-3.5 h-3.5 mr-1.5 hidden shrink-0" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Reporting &amp; docs
          </button>
          <button type="button" data-value="Onboarding de nouveaux clients" role="checkbox" aria-checked="false" class="chip chip-multi px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40 inline-flex items-center">
            <svg class="chip-check w-3.5 h-3.5 mr-1.5 hidden shrink-0" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Onboarding clients
          </button>
          <button type="button" data-value="Emails et communication client" role="checkbox" aria-checked="false" class="chip chip-multi px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40 inline-flex items-center">
            <svg class="chip-check w-3.5 h-3.5 mr-1.5 hidden shrink-0" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Emails &amp; com client
          </button>
          <button type="button" data-value="Gestion administrative générale" role="checkbox" aria-checked="false" class="chip chip-multi px-5 py-2.5 rounded-lg bg-navy-light/50 border border-white/10 text-sm text-warm-gray cursor-pointer select-none transition-all duration-200 hover:border-purple/40 inline-flex items-center">
            <svg class="chip-check w-3.5 h-3.5 mr-1.5 hidden shrink-0" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Gestion admin
          </button>
        </div>
      </div>

      <!-- RGPD consent -->
      <div class="flex items-start gap-3 text-left">
        <input type="checkbox" id="consent-checkbox" required class="mt-1 w-4 h-4 accent-purple cursor-pointer shrink-0" />
        <label for="consent-checkbox" class="text-xs text-warm-gray/70 leading-relaxed">
          J'accepte que mes données soient traitées pour recevoir l'audit et les communications de L'Atelier Automatisation. <a href="/mentions-legales" class="text-purple-light underline hover:text-white">Politique de confidentialité</a>.
        </label>
      </div>

      <!-- Error message -->
      <p id="form-error" class="text-red-400 text-sm text-center hidden"></p>

      <button
        type="submit"
        id="submit-btn"
        class="w-full mt-2 px-7 py-3.5 bg-purple hover:bg-purple-dark text-white font-semibold rounded-xl btn-glow text-base disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Faire l'audit
      </button>
    </form>

    <p class="text-xs text-warm-gray/50">Pas de spam. Un email de bienvenue, c'est tout.</p>
  </div>
</section>

<script>
  // If already opted in, skip
  if (localStorage.getItem('lm_email')) {
    window.location.replace('/audit');
  }

  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  // Secteur — choix unique (radio behavior)
  function initSingleSelect(containerId, hiddenId) {
    const container = document.getElementById(containerId);
    const hidden = document.getElementById(hiddenId);
    if (!container || !hidden) return;
    container.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        container.querySelectorAll('.chip').forEach(c => {
          c.classList.remove('border-purple', 'bg-purple/10', 'text-white');
          c.classList.add('border-white/10', 'text-warm-gray');
          c.setAttribute('aria-checked', 'false');
        });
        chip.classList.add('border-purple', 'bg-purple/10', 'text-white');
        chip.classList.remove('border-white/10', 'text-warm-gray');
        chip.setAttribute('aria-checked', 'true');
        hidden.value = chip.dataset.value;
      });
    });
  }

  // Pain point — choix multiple (toggle behavior)
  function initMultiSelect(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.querySelectorAll('.chip-multi').forEach(chip => {
      chip.addEventListener('click', () => {
        const isChecked = chip.getAttribute('aria-checked') === 'true';
        chip.setAttribute('aria-checked', String(!isChecked));
        chip.classList.toggle('border-purple');
        chip.classList.toggle('bg-purple/10');
        chip.classList.toggle('text-white');
        chip.classList.toggle('border-white/10');
        chip.classList.toggle('text-warm-gray');
        chip.querySelector('.chip-check').classList.toggle('hidden');
      });
    });
  }

  initSingleSelect('sector-chips', 'sector-input');
  initMultiSelect('pain-chips');

  // Submit
  const form = document.getElementById('email-form');
  if (form) {
    const submitBtn = document.getElementById('submit-btn');
    const formError = document.getElementById('form-error');

    function showError(msg) {
      formError.textContent = msg;
      formError.classList.remove('hidden');
    }

    function hideError() {
      formError.classList.add('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const name = document.getElementById('name-input').value.trim();
      const email = document.getElementById('email-input').value.trim();
      const sector = document.getElementById('sector-input').value;
      const consent = document.getElementById('consent-checkbox').checked;
      const painPoints = [...document.querySelectorAll('#pain-chips .chip-multi[aria-checked="true"]')]
        .map(c => c.dataset.value);

      // Validation
      if (!name) { showError('Merci de renseigner ton prénom.'); return; }
      if (!email) { showError('Merci de renseigner ton email.'); return; }
      if (!EMAIL_REGEX.test(email)) { showError('Merci de saisir un email valide.'); return; }
      if (!sector) { showError('Merci de choisir ton secteur.'); return; }
      if (painPoints.length === 0) { showError('Merci de sélectionner au moins une perte de temps.'); return; }
      if (!consent) { showError('Merci d\'accepter la politique de confidentialité.'); return; }

      // Loading state
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi...';

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 10000);

        await fetch('https://n8n.srv824812.hstgr.cloud/webhook/lead-magnet-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, sector, painPoint: painPoints, source: 'lead-magnet', userAgent: navigator.userAgent }),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);
      } catch (err) {
        if (err.name === 'AbortError') {
          showError('Le serveur met trop de temps à répondre. Réessaie dans un instant.');
        } else {
          showError('Erreur réseau. Vérifie ta connexion et réessaie.');
        }
        submitBtn.disabled = false;
        submitBtn.textContent = 'Faire l\'audit';
        return;
      }

      localStorage.setItem('lm_email', email);
      localStorage.setItem('lm_name', name);
      localStorage.setItem('lm_sector', sector);
      localStorage.setItem('lm_pain', JSON.stringify(painPoints));

      window.location.href = '/audit';
    });
  }
</script>
