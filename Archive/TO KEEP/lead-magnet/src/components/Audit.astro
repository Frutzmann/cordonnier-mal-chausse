---
const competences = [
  {
    id: 'negociation',
    title: 'Négociation fournisseurs',
    description: 'Les conditions tarifaires, les seuils de remise, les contacts clés.',
    question: 'Si ton acheteur senior part demain, tu paies combien de plus ?',
  },
  {
    id: 'escalade',
    title: 'Escalade clients mécontents',
    description: "Le process exact quand un client menace de partir. Qui appeler, quoi dire, dans quel ordre.",
    question: "Ton meilleur commercial gère ça \"au feeling\". Et si c'est un junior qui répond ?",
  },
  {
    id: 'onboarding',
    title: "Onboarding nouveaux collaborateurs",
    description: "Les 50 micro-décisions des 30 premiers jours. Pas la checklist RH — le vrai parcours.",
    question: "Combien de temps avant qu'un nouveau soit autonome ? 3 mois ? 6 ?",
  },
  {
    id: 'tarification',
    title: 'Tarification sur-mesure',
    description: "Les règles non-écrites pour pricer un projet complexe. Marges, exceptions, signaux d'alerte.",
    question: "Qui sait pricer sans toi ? Et si cette personne part aussi ?",
  },
  {
    id: 'qualite',
    title: 'Contrôle qualité terrain',
    description: "Les vérifications instinctives qu'un expert fait sans y penser. Les détails qui évitent une catastrophe.",
    question: "Ton expert qualité a 25 ans d'expérience. Combien de ses réflexes sont écrits ?",
  },
  {
    id: 'comptable',
    title: 'Process comptable spécifique',
    description: "Les exceptions fiscales, les ventilations particulières, les règles maison.",
    question: "Ta comptable est en arrêt. Le cabinet externe facture combien pour comprendre ton système ?",
  },
  {
    id: 'juridique',
    title: 'Conformité réglementaire',
    description: "Les obligations spécifiques à ton secteur. Les deadlines, les formulaires, les pièges.",
    question: "Tu découvres un contrôle lundi. Qui sait exactement quoi préparer ?",
  },
  {
    id: 'relation',
    title: 'Relation client historique',
    description: "L'historique, les préférences, les non-dits. Ce que le CRM ne capture pas.",
    question: "Ton client n°1 appelle. Ton commercial est en vacances. Qui sait qu'il déteste les emails ?",
  },
];
---

<section id="audit" class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Score sticky bar -->
    <div id="score-bar" class="sticky top-0 z-30 bg-navy/95 backdrop-blur-sm border-b border-white/10 py-4 px-6 rounded-b-2xl mb-12">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-warm-gray">Compétences à risque dans ta boîte</span>
        <span id="score-counter" class="text-2xl font-bold text-purple-light">0 <span class="text-base font-normal text-warm-gray">/ 8</span></span>
      </div>
      <div class="w-full bg-navy-light rounded-full h-2.5 overflow-hidden">
        <div id="progress-bar" class="bg-purple h-2.5 rounded-full transition-all duration-500 ease-out" style="width: 0%"></div>
      </div>
      <div id="score-message" class="mt-3 text-sm transition-opacity duration-500 opacity-0"></div>
    </div>

    <div class="text-center mb-12 fade-in">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Combien de compétences critiques reposent sur une seule personne ?</h2>
      <p class="text-warm-gray text-lg max-w-2xl mx-auto">Coche chaque compétence qui n'est <strong class="text-white">pas documentée</strong> dans ta boîte.</p>
    </div>

    <!-- Competence cards -->
    <div class="grid gap-4 stagger-children" id="audit-grid">
      {competences.map((comp, i) => (
        <div
          class="audit-card fade-in bg-navy-light/50 border border-white/10 rounded-xl p-6 cursor-pointer select-none"
          data-id={comp.id}
          data-index={i}
        >
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 mt-1">
              <div class="w-6 h-6 rounded-md border-2 border-white/30 flex items-center justify-center transition-all duration-200 checkbox-visual">
                <svg class="w-4 h-4 text-white opacity-0 transition-opacity duration-200 check-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-white mb-1">{comp.title}</h3>
              <p class="text-warm-gray text-sm mb-2">{comp.description}</p>
              <p class="text-purple-light text-sm italic">"{comp.question}"</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA to next section -->
    <div id="audit-cta" class="mt-10 text-center opacity-0 transition-opacity duration-500">
      <a href="#template" class="inline-flex items-center gap-2 px-8 py-4 bg-purple hover:bg-purple-dark text-white font-semibold rounded-xl btn-glow text-lg">
        Maintenant, essaie d'en documenter une
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
      </a>
    </div>
  </div>
</section>

<script>
  let score = 0;
  const cards = document.querySelectorAll('.audit-card');
  const counter = document.getElementById('score-counter');
  const progressBar = document.getElementById('progress-bar');
  const scoreMessage = document.getElementById('score-message');
  const auditCta = document.getElementById('audit-cta');
  let auditTracked = false;

  const messages = {
    low: { text: "Pas mal. Mais es-tu sûr que tout est vraiment documenté ?", color: "text-green-400" },
    mid: { text: "Zone orange. Chaque départ te coûte des mois de productivité.", color: "text-accent-gold" },
    high: { text: "Alerte rouge. Ton entreprise repose sur des cerveaux, pas des process.", color: "text-red-400" },
  };

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const isChecked = card.classList.toggle('checked');
      const checkbox = card.querySelector('.checkbox-visual');
      const checkIcon = card.querySelector('.check-icon');

      if (isChecked) {
        score++;
        checkbox.classList.add('bg-purple', 'border-purple');
        checkIcon.classList.remove('opacity-0');
        checkbox.classList.add('check-bounce');
        setTimeout(() => checkbox.classList.remove('check-bounce'), 400);
      } else {
        score--;
        checkbox.classList.remove('bg-purple', 'border-purple');
        checkIcon.classList.add('opacity-0');
      }

      // Update counter
      counter.innerHTML = `${score} <span class="text-base font-normal text-warm-gray">/ 8</span>`;
      counter.classList.add('score-pop');
      setTimeout(() => counter.classList.remove('score-pop'), 300);

      // Update progress bar
      progressBar.style.width = `${(score / 8) * 100}%`;

      // Update message
      if (score === 0) {
        scoreMessage.classList.add('opacity-0');
      } else {
        scoreMessage.classList.remove('opacity-0');
        const level = score <= 2 ? 'low' : score <= 5 ? 'mid' : 'high';
        scoreMessage.className = `mt-3 text-sm transition-opacity duration-500 ${messages[level].color}`;
        scoreMessage.textContent = messages[level].text;
      }

      // Show CTA if >= 1
      auditCta.style.opacity = score >= 1 ? '1' : '0';
    });
  });

  // Track audit_completed on scroll past section
  const auditSection = document.getElementById('audit');
  const auditObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting && entry.boundingClientRect.top < 0 && !auditTracked && score > 0) {
        auditTracked = true;
        window.trackEvent('audit_completed', { score });
      }
    });
  }, { threshold: 0 });
  auditObserver.observe(auditSection);
</script>
