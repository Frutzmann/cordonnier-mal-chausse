---
---
<section id="template" class="py-20 px-4 border-t border-white/5">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12 fade-in">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Essaie de documenter une compétence</h2>
      <p class="text-warm-gray text-lg max-w-xl mx-auto">Choisis la compétence que tu maîtrises le mieux. Remplis le template ci-dessous.</p>
    </div>

    <!-- Fields counter -->
    <div class="sticky top-0 z-20 bg-navy/95 backdrop-blur-sm border-b border-white/10 py-3 px-6 rounded-b-2xl mb-8 fade-in">
      <div class="flex items-center justify-between">
        <span class="text-sm text-warm-gray">Champs remplis</span>
        <span id="template-counter" class="text-lg font-bold text-purple-light">0 <span class="text-sm font-normal text-warm-gray">/ 17</span></span>
      </div>
      <div class="w-full bg-navy-light rounded-full h-2 mt-2 overflow-hidden">
        <div id="template-progress" class="bg-purple h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
      </div>
    </div>

    <!-- Nudge message (hidden, shows after 30s if <5 fields) -->
    <div id="template-nudge" class="mb-8 p-5 bg-purple/10 border border-purple/30 rounded-xl text-center opacity-0 transition-opacity duration-500">
      <p class="text-purple-light text-base font-medium">C'est plus dur qu'on croit, non ?</p>
      <p class="text-warm-gray text-sm mt-1">Regarde a quoi ca ressemble quand c'est bien fait.</p>
      <a href="#exemple" class="inline-block mt-3 text-purple-light underline hover:text-white transition-colors text-sm">Voir l'exemple &darr;</a>
    </div>

    <form id="template-form" class="space-y-8 fade-in" autocomplete="off">
      <!-- Nom de la compétence -->
      <div>
        <label class="block text-sm font-semibold text-white mb-2">Nom de la compétence</label>
        <input type="text" data-field="nom" placeholder='Ex: "Escalade client mécontent"'
          class="w-full px-4 py-3 bg-navy-light/60 border border-white/15 rounded-lg text-white placeholder-warm-gray/40 input-focus" />
      </div>

      <!-- Déclencheur -->
      <div>
        <label class="block text-sm font-semibold text-white mb-2">Déclencheur — Quand est-ce qu'on active ce process ?</label>
        <input type="text" data-field="declencheur" placeholder="Ex: Un client appelle pour se plaindre d'une livraison"
          class="w-full px-4 py-3 bg-navy-light/60 border border-white/15 rounded-lg text-white placeholder-warm-gray/40 input-focus" />
      </div>

      <!-- 5 étapes -->
      <div>
        <label class="block text-sm font-semibold text-white mb-4">Les 5 étapes clés (dans l'ordre)</label>
        <div class="space-y-3">
          {[1, 2, 3, 4, 5].map(n => (
            <div class="flex items-center gap-3">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-navy-light border border-white/20 flex items-center justify-center text-sm font-bold text-purple-light">{n}</span>
              <input type="text" data-field={`etape${n}`} placeholder={`Étape ${n}`}
                class="flex-1 px-4 py-3 bg-navy-light/60 border border-white/15 rounded-lg text-white placeholder-warm-gray/40 input-focus" />
            </div>
          ))}
        </div>
      </div>

      <!-- TOUJOURS -->
      <div>
        <label class="block text-sm font-semibold text-green-400 mb-3 flex items-center gap-2">
          <span class="w-3 h-3 bg-green-500 rounded-full"></span>
          TOUJOURS — Les règles absolues
        </label>
        <div class="space-y-3">
          {[1, 2, 3].map(n => (
            <div class="field-always pl-4">
              <input type="text" data-field={`toujours${n}`} placeholder={`Règle #${n} — Ex: Toujours rappeler dans les 2h`}
                class="w-full px-4 py-3 bg-navy-light/60 border border-white/15 rounded-lg text-white placeholder-warm-gray/40 input-focus" />
            </div>
          ))}
        </div>
      </div>

      <!-- JAMAIS -->
      <div>
        <label class="block text-sm font-semibold text-red-400 mb-3 flex items-center gap-2">
          <span class="w-3 h-3 bg-red-500 rounded-full"></span>
          JAMAIS — Les interdits
        </label>
        <div class="space-y-3">
          {[1, 2, 3].map(n => (
            <div class="field-never pl-4">
              <input type="text" data-field={`jamais${n}`} placeholder={`Interdit #${n} — Ex: Jamais proposer un geste commercial par email`}
                class="w-full px-4 py-3 bg-navy-light/60 border border-white/15 rounded-lg text-white placeholder-warm-gray/40 input-focus" />
            </div>
          ))}
        </div>
      </div>

      <!-- EXCEPTIONS -->
      <div>
        <label class="block text-sm font-semibold text-accent-gold mb-3 flex items-center gap-2">
          <span class="w-3 h-3 bg-accent-gold rounded-full"></span>
          EXCEPTIONS — Les cas spéciaux
        </label>
        <div class="space-y-3">
          {[1, 2, 3].map(n => (
            <div class="field-exception pl-4">
              <input type="text" data-field={`exception${n}`} placeholder={`Exception #${n} — Ex: Si CA client > 100k, escalader directement au DG`}
                class="w-full px-4 py-3 bg-navy-light/60 border border-white/15 rounded-lg text-white placeholder-warm-gray/40 input-focus" />
            </div>
          ))}
        </div>
      </div>
    </form>

    <!-- CTA to example -->
    <div class="mt-10 text-center fade-in">
      <a href="#exemple" class="inline-flex items-center gap-2 px-8 py-4 bg-navy-light border border-purple/40 text-purple-light hover:bg-purple hover:text-white font-semibold rounded-xl transition-all duration-300 text-lg">
        Voir l'exemple
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
      </a>
    </div>
  </div>
</section>

<script>
  const templateForm = document.getElementById('template-form');
  const templateCounter = document.getElementById('template-counter');
  const templateProgress = document.getElementById('template-progress');
  const templateNudge = document.getElementById('template-nudge');
  const fields = templateForm.querySelectorAll('input[data-field]');
  let templateStartTracked = false;
  let nudgeTimer = null;
  let filledCount = 0;

  function updateCounter() {
    filledCount = 0;
    fields.forEach(f => { if (f.value.trim()) filledCount++; });
    templateCounter.innerHTML = `${filledCount} <span class="text-sm font-normal text-warm-gray">/ 17</span>`;
    templateProgress.style.width = `${(filledCount / 17) * 100}%`;
  }

  fields.forEach(field => {
    field.addEventListener('input', () => {
      updateCounter();
      if (!templateStartTracked && field.value.trim()) {
        templateStartTracked = true;
        window.trackEvent('template_started');
      }
    });
  });

  // Nudge timer: if section enters viewport and <5 fields after 30s
  const templateSection = document.getElementById('template');
  const templateObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !nudgeTimer) {
        nudgeTimer = setTimeout(() => {
          if (filledCount < 5) {
            templateNudge.style.opacity = '1';
          }
        }, 30000);
      }
    });
  }, { threshold: 0.3 });
  templateObserver.observe(templateSection);
</script>
